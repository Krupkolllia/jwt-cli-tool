#!/bin/sh
# Thin wrapper that runs the shaded jwt-tool jar.
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
JAR="$DIR/target/jwt-tool.jar"

if [ ! -f "$JAR" ]; then
  echo "jwt-tool: build not found at $JAR" >&2
  echo "jwt-tool: run 'mvn package' first to build it." >&2
  exit 1
fi

exec java -jar "$JAR" "$@"
